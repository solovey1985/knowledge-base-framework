{
  "contentRootPath": "./content",
  "title": "{{PROJECT_NAME}}",
  "description": "{{PROJECT_NAME}} knowledge base",
  "baseUrl": "",
  "server": {
    "port": 3000
  },
  "build": {
    "outputDir": "./docs",
    "clean": true,
    "generateSitemap": true,
    "generateRobots": true
  },
  "navigation": {
    "maxDepth": 3,
    "excludePatterns": ["README.md", ".*"]
  },
  "search": {
    "enabled": true,
    "indexFileName": "search-index.json",
    "indexFilePath": ".kb-search-index.json",
    "titleBoost": 10,
    "bodyBoost": 1
  },
  "templates": {
    "assetsBasePath": "/framework-assets"
  },
  "pluginsConfigPath": "./kb.plugins.json"
}
